# Frontend environment — production (Render)
# These are injected at BUILD TIME by Render from render.yaml envVars.
# Do NOT commit real values here — this file is just for documentation.

# Backend URL (set automatically by Render from simpleci-backend service)
VITE_API_BASE_URL=https://simpleci-backend.onrender.com

# WebSocket URL (same host, protocol switches http→ws automatically in RunDetail)
VITE_WS_URL=wss://simpleci-backend.onrender.com
