{
  "name": "@simpleci/backend",
  "description": "SimpleCI — College-level CI/CD orchestration backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "concurrently -n server,worker -c blue,green \"tsx watch src/server.ts\" \"tsx watch src/worker.ts\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "echo 'No tests yet — SimpleCI pipeline passing' && exit 0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/client": "^5.14.0",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.7.6",
    "connect-redis": "^6.1.3",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "js-yaml": "^4.1.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "tar": "^7.5.23",
    "ws": "^8.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.29",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.2",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/tar": "^6.1.13",
    "@types/ws": "^8.5.10",
    "concurrently": "^10.0.7",
    "prisma": "^5.14.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
