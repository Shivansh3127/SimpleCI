// This is your Prisma schema file — it defines your database tables.
// Run `npm run db:migrate` to apply changes to your local database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── A GitHub user who has logged in via OAuth ──────────────────
model User {
  id          String       @id @default(uuid())
  githubId    String       @unique  // GitHub's numeric user ID (never changes)
  username    String                // GitHub login handle e.g. "Shivansh3127"
  avatarUrl   String?               // GitHub avatar URL
  accessToken String                // OAuth token — used to call GitHub API (commit status)
  createdAt   DateTime     @default(now())

  repos Repository[]

  @@map("users")
}

// ── A GitHub repo registered by a user for CI ─────────────────
// Each repo gets its own unique webhook secret — no more single .env secret.
model Repository {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoName      String              // e.g. "SimpleCI"
  repoUrl       String   @unique    // e.g. "https://github.com/Shivansh3127/SimpleCI.git"
  webhookSecret String              // unique HMAC secret for this repo's webhook
  createdAt     DateTime @default(now())

  runs Run[]

  @@map("repositories")
}

// ── A pipeline "run" — created every time GitHub fires a webhook ──
model Run {
  id           String      @id @default(uuid())
  repositoryId String?                        // FK to Repository (nullable for backwards compat)
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  repoName     String
  repoUrl      String
  branch       String
  commitSha    String
  commitMsg    String
  status       String      @default("QUEUED") // QUEUED | RUNNING | SUCCESS | FAILED | CANCELLED
  containerId  String?                        // Docker container ID for cancellation
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?

  logs Log[]

  @@map("runs")
}

// ── Each line of output from the Docker container ─────────────
model Log {
  id        Int      @id @default(autoincrement())
  runId     String
  line      String
  createdAt DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("logs")
}
